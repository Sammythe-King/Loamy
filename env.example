# Copy this file to ".env" and fill in the real values.
# The real ".env" is gitignored and must NEVER be committed.
# Ask the project owner for the actual secret values.

# --- Meta WhatsApp Cloud API ---
# You choose this string; paste the SAME value into the Meta webhook config.
WHATSAPP_VERIFY_TOKEN=your_verify_token_here

# Meta app -> WhatsApp -> API Setup. Use a permanent System User token for prod.
WHATSAPP_ACCESS_TOKEN=your_meta_access_token_here

# Meta app -> WhatsApp -> API Setup -> Phone number ID.
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here

# --- Google OAuth (Sign-In + Gmail sync) ---
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client ID.
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# --- Owner kill switch ---
# Leave blank/unset for normal operation. Set to "on" to make the backend
# refuse all traffic (returns 503) except /health. Only whoever controls the
# deployment environment can flip this.
LOAMY_KILL_SWITCH=
