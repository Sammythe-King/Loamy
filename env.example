# Copy this file to ".env" and fill in the real values.
# The real ".env" is gitignored and must NEVER be committed.
# Ask the project owner for the actual secret values.

# --- Meta WhatsApp Cloud API ---
# You choose this string; paste the SAME value into the Meta webhook config.
WHATSAPP_VERIFY_TOKEN=your_verify_token_here

# Meta app -> WhatsApp -> API Setup. Use a permanent System User token for prod.
WHATSAPP_ACCESS_TOKEN=your_meta_access_token_here

# Meta app -> WhatsApp -> API Setup -> Phone number ID.
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here

# --- Google OAuth (Sign-In + Gmail sync) ---
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client ID.
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# --- Gemini ---
# Every LLM call goes through gemini_gateway.py, which owns the key and the limits.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
# Hard caps, counted in Supabase (table gemini_rate_limits) so they survive restarts
# and are shared by every instance. Run scripts/sql/005_gemini_rate_limits.sql first.
GEMINI_GLOBAL_DAILY_LIMIT=1500
GEMINI_FEATURE_HOURLY_LIMIT=120
GEMINI_USER_HOURLY_LIMIT=60
GEMINI_USER_TOTAL_HOURLY_LIMIT=150
# Optional per-feature overrides, e.g. chat_reply=200,receipt_vision=40
GEMINI_FEATURE_LIMITS=

# --- Background scheduler ---
# On by default. Set to false on every instance except ONE, otherwise each instance
# runs its own Gmail auto-sync and invoice reminders and multiplies the Gemini calls.
ENABLE_SCHEDULER=true

# --- Owner kill switch ---
# Leave blank/unset for normal operation. Set to "on" to make the backend
# refuse all traffic (returns 503) except /health. Only whoever controls the
# deployment environment can flip this.
LOAMY_KILL_SWITCH=
